# Copy to .env.local for local development (never commit .env.local)

# Supabase / Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional OAuth
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Tunnel Review API (camera-system ApiStack)
# TUNNEL_REVIEW_API_BASE_URL="https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/prod"
# TUNNEL_REVIEW_API_KEY="YOUR_API_KEY"
