# ── Frontend (Vite) ──────────────────────────────────────────────────
# Main API endpoint (EzCarRental API Gateway)
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_ENV=development

# Cognito authentication
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_AWS_REGION=us-east-1

# Tunnel Review API (camera-system ApiStack outputs)
# After `cdk deploy TunnelApi`, grab the ApiUrl output and the API key from AWS Console.
VITE_TUNNEL_REVIEW_API_BASE_URL=
VITE_TUNNEL_REVIEW_API_KEY=

# Pi health endpoint (optional — used by inspection station page)
# Point this at the Raspberry Pi trigger_server address, e.g. http://192.168.1.50:8000
VITE_PI_HEALTH_URL=
